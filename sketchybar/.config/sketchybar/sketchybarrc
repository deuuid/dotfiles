PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

sketchybar --bar \
  position=top \
  height=32 \
  color=0xff000000

default=(
  padding_left=4
  padding_right=4
  icon.font="SF Pro:Normal:13.0"
  label.font="SF Pro:Normal:13.0"
  icon.color=$ACTIVE
  label.color=$ACTIVE
  icon.padding_left=6
  icon.padding_right=6
  label.padding_left=6
  label.padding_right=6
)

sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_focus_change

sketchybar --add item archlinux left \
  --set archlinux \
    icon="󰣇" \
    label.drawing=off \
    icon.color=$MAIN \
    icon.font="SF Pro:Normal:16.0" \
    click_script="open -na /Applications/kitty.app --args --hold fastfetch"

sketchybar --add item chevron_1 left \
  --set chevron_1 \
    icon="󰅂" \
    label.drawing=off \
    icon.color=$INACTIVE

for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid \
      icon.drawing=off \
      label="$sid" \
      click_script="aerospace workspace $sid" \
      script="$CONFIG_DIR/plugins/aerospace.sh $sid"

  if [ "$sid" = "4" ]; then
    sketchybar --add item chevron_2 left \
      --set chevron_2 \
        icon="󰅂" \
        label.drawing=off \
        icon.color=$INACTIVE
  fi
done

sketchybar --add item chevron left \
  --set chevron \
    icon="󰅂" \
    label.drawing=off \
    icon.color=$INACTIVE

sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    label.color=$ACTIVE \
    script="$PLUGIN_DIR/front.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item battery right \
  --set battery \
    update_freq=20 \
    icon.padding_right=3 \
    label.padding_left=3 \
    icon.color=$ACTIVE \
    label.color=$ACTIVE \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item clock right \
  --set clock \
    update_freq=5 \
    icon.drawing=off \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --add item date right \
  --set date \
    update_freq=120 \
    icon.drawing=off \
    script="$PLUGIN_DIR/date.sh" \
    click_script="$HOME/.config/aerospace/scripts/calendar.sh"

sketchybar --add event input_source_change "com.apple.Carbon.TISNotifySelectedKeyboardInputSourceChanged"

sketchybar --add item lang right \
  --subscribe lang input_source_change \
  --set lang \
    icon.drawing=off \
    update_freq=30 \
    label.color=$ACTIVE \
    script="$PLUGIN_DIR/lang.sh"

sketchybar --add item headphones right \
  --subscribe headphones system_woke \
  --set headphones \
    icon="󰋋" \
    label.drawing=off \
    update_freq=5 \
    script="$PLUGIN_DIR/headphones.sh"

sketchybar --add item amneziawg right \
  --set amneziawg \
    icon="AZ" \
    label.drawing=off \
    update_freq=5 \
    script="$PLUGIN_DIR/amneziawg.sh"

sketchybar --add item openvpn right \
  --set openvpn \
    icon="OV" \
    label.drawing=off \
    update_freq=5 \
    script="$PLUGIN_DIR/openvpn.sh"

sketchybar --add item xray right \
  --set xray \
    drawing=on \
    icon.drawing=off \
    label="XR" \
    update_freq=5 \
    script="$PLUGIN_DIR/xray.sh"

sketchybar --add item claude right \
  --set claude \
    icon="󰚩" \
    label.drawing=off \
    icon.padding_right=3 \
    update_freq=5 \
    script="$PLUGIN_DIR/claude.sh"

sketchybar --update
